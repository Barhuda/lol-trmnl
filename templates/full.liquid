{% assign matches_oldest_first = recentMatches | reverse %}
{% assign last3 = recentMatches | slice: 0, 3 %}

<div class="view view--full">
<div style="background: #ffffff; color: #000000; width: 800px; height: 480px; padding: 20px 26px; display: flex; flex-direction: column; font-family: monospace; box-sizing: border-box;">

  <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 12px;">
    <span style="font-size: 17px; font-weight: 700; letter-spacing: 0.5px;">{{ riotId | upcase }}</span>
    <span style="font-size: 12px; color: #444;">SOLO/DUO &middot; {{ region }}</span>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 14px;">

    <div style="border-right: 2px solid #000; padding-right: 18px; display: flex; flex-direction: column; justify-content: center;">
      {% if soloDuo %}
        <div style="font-size: 28px; font-weight: 700; line-height: 1;">{{ soloDuo.tier }} {{ soloDuo.rank }}</div>
        <div style="font-size: 13px; margin-top: 4px;">{{ soloDuo.leaguePoints }} LP</div>
        <div style="font-size: 11px; color: #333; margin-top: 6px;">{{ soloDuo.winrate }}% WR &middot; {{ soloDuo.wins }}W {{ soloDuo.losses }}L</div>
      {% else %}
        <div style="font-size: 20px; font-weight: 700;">UNRANKED</div>
      {% endif %}
    </div>

    <div style="display: flex; flex-direction: column; justify-content: center; gap: 10px;">
      <div>
        <div style="font-size: 9px; color: #555; margin-bottom: 4px;">LAST {{ recentMatches | size }} (OLDEST &rarr; NEWEST)</div>
        <div style="display: flex; gap: 3px;">
          {% for m in matches_oldest_first %}
            {% if m.win %}
              <span style="width:12px;height:12px;background:#000;"></span>
            {% else %}
              <span style="width:12px;height:12px;border:1.5px solid #000;"></span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div style="display: flex; gap: 12px;">
        <div style="border: 2px solid #000; padding: 6px 10px; flex: 1;">
          <div style="font-size: 9px; color: #555;">AVG KDA</div>
          <div style="font-size: 17px; font-weight: 700;">{{ avgKda }}</div>
        </div>
        <div style="border: 2px solid #000; padding: 6px 10px; flex: 1;">
          <div style="font-size: 9px; color: #555;">AVG CS/MIN</div>
          <div style="font-size: 17px; font-weight: 700;">{{ avgCsPerMin }}</div>
        </div>
      </div>
    </div>
  </div>

  <div style="border-top: 2px solid #000; padding-top: 10px; margin-bottom: 12px;">
    <div style="font-size: 9px; color: #555; margin-bottom: 8px;">LAST 3 GAMES</div>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
      {% for m in last3 %}
        <div style="border: 2px solid #000; padding: 8px 10px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <img
              src="https://ddragon.leagueoflegends.com/cdn/{{ ddragonVersion }}/img/champion/{{ m.champion }}.png"
              width="28" height="28"
              style="border: 1.5px solid #000; object-fit: cover;"
              onerror="this.style.display='none'"
            />
            <div>
              <div style="font-size: 12px; font-weight: 700;">{{ m.champion }}</div>
              <div style="font-size: 9px; color: #444;">{{ m.position | downcase }} &middot; {{ m.durationMin }}m</div>
            </div>
            <div style="margin-left: auto; font-size: 10px; font-weight: 700; border: 1.5px solid #000; padding: 1px 5px;">
              {% if m.win %}W{% else %}L{% endif %}
            </div>
          </div>
          <div style="font-size: 11px; margin-bottom: 4px;">{{ m.kills }}/{{ m.deaths }}/{{ m.assists }} &middot; {{ m.kda }} KDA</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; font-size: 9px; color: #333;">
            <span>CS/min {{ m.csPerMin }}</span>
            <span>Vision {{ m.visionScore }}</span>
            <span>Dmg {{ m.damageDealt }}</span>
            <span>Gold {{ m.goldEarned }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div style="border-top: 2px solid #000; padding-top: 10px; flex: 1;">
    <div style="font-size: 9px; color: #555; margin-bottom: 6px;">TOP CHAMPIONS</div>
    <div style="display: flex; flex-direction: column; gap: 5px;">
      {% for c in topChampions %}
        <div style="display: grid; grid-template-columns: 28px 90px 34px 1fr 40px; align-items: center; font-size: 12px; gap: 8px;">
          <img
            src="https://ddragon.leagueoflegends.com/cdn/{{ ddragonVersion }}/img/champion/{{ c.champion }}.png"
            width="28" height="28"
            style="border: 1.5px solid #000; object-fit: cover;"
            onerror="this.style.display='none'"
          />
          <span>{{ c.champion }}</span>
          <span style="color: #444;">{{ c.games }}g</span>
          <div style="height: 8px; border: 1.5px solid #000; position: relative;">
            <div style="position:absolute; top:0; left:0; bottom:0; width: {{ c.winrate }}%; background:#000;"></div>
          </div>
          <span style="text-align: right;">{{ c.winrate }}%</span>
        </div>
      {% endfor %}
    </div>
  </div>

  <div style="text-align: right; font-size: 9px; color: #666; margin-top: 8px;">
    updated {{ updatedAt }} &middot; refresh every 30 min
  </div>

</div>
</div>
