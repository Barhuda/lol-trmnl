{% assign last3 = recentMatches | slice: 0, 3 %}
{% assign last20_wins = recentMatches | where: "win", true | size %}
{% assign last20_total = recentMatches | size %}
{% assign last20_winrate = last20_wins | times: 100.0 | divided_by: last20_total | round: 1 %}

<div class="view view--full">
<div style="background: #ffffff; color: #000000; width: 800px; height: 480px; padding: 16px 26px; display: flex; flex-direction: column; font-family: monospace; box-sizing: border-box;">

  <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 12px;">
    <span style="font-size: 17px; font-weight: 700; letter-spacing: 0.5px;">{{ riotId | upcase }}</span>
    <span style="font-size: 12px; color: #444;">SOLO/DUO &middot; {{ region }}</span>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 10px;">

    <div style="border-right: 2px solid #000; padding-right: 18px; display: flex; flex-direction: column; justify-content: center;">
      {% if soloDuo %}
        <div style="font-size: 28px; font-weight: 700; line-height: 1;">{{ soloDuo.tier }} {{ soloDuo.rank }}</div>
        <div style="font-size: 13px; margin-top: 4px;">{{ soloDuo.leaguePoints }} LP</div>
        <div style="font-size: 11px; color: #333; margin-top: 6px;">{{ soloDuo.winrate }}% WR &middot; {{ soloDuo.wins }}W {{ soloDuo.losses }}L</div>
      {% else %}
        <div style="font-size: 20px; font-weight: 700;">UNRANKED</div>
      {% endif %}
    </div>

    <div style="display: flex; flex-direction: column; justify-content: center; gap: 10px;">
      <div>
        <div style="font-size: 9px; color: #555; margin-bottom: 4px;">LAST {{ last20_total }} &middot; {{ last20_winrate }}% WR (NEWEST &rarr; OLDEST)</div>
        <div style="display: flex; gap: 3px;">
          {% for m in recentMatches %}
            {% if m.win %}
              <span style="width:12px;height:12px;background:#000;"></span>
            {% else %}
              <span style="width:12px;height:12px;border:1.5px solid #000;"></span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div style="display: flex; gap: 12px;">
        <div style="border: 2px solid #000; padding: 6px 10px; flex: 1;">
          <div style="font-size: 9px; color: #555;">AVG KDA</div>
          <div style="font-size: 17px; font-weight: 700;">{{ avgKda }}</div>
        </div>
        <div style="border: 2px solid #000; padding: 6px 10px; flex: 1;">
          <div style="font-size: 9px; color: #555;">AVG CS/MIN</div>
          <div style="font-size: 17px; font-weight: 700;">{{ avgCsPerMin }}</div>
        </div>
      </div>
    </div>
  </div>

  <div style="border-top: 2px solid #000; padding-top: 8px; margin-bottom: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
      <span style="font-size: 9px; color: #555;">RANKED LP TREND ({{ lpHistory | size }} GAMES)</span>
      {% if lpChartMin %}
        <span style="font-size: 9px; color: #444;">{{ lpChartMin }} &rarr; {{ lpChartMax }}</span>
      {% endif %}
    </div>
    {% if lpChartPoints and lpChartPoints != "" %}
      <svg viewBox="0 0 300 60" width="748" height="42" preserveAspectRatio="none" style="display: block;">
        <polyline points="{{ lpChartPoints }}" fill="none" stroke="#000" stroke-width="2.5" />
      </svg>
    {% else %}
      <div style="font-size: 10px; color: #666; height: 42px; display: flex; align-items: center;">Sammle Daten &ndash; Trend erscheint nach dem naechsten gewerteten Spiel.</div>
    {% endif %}
  </div>

  <div style="border-top: 2px solid #000; padding-top: 10px; margin-bottom: 12px;">
    <div style="font-size: 9px; color: #555; margin-bottom: 8px;">LAST 3 GAMES</div>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
      {% for m in last3 %}
        <div style="border: 2px solid #000; padding: 6px 8px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px;">
            <img
              src="https://ddragon.leagueoflegends.com/cdn/{{ ddragonVersion }}/img/champion/{{ m.champion }}.png"
              width="28" height="28"
              style="border: 1.5px solid #000; object-fit: cover;"
              onerror="this.style.display='none'"
            />
            <div>
              <div style="font-size: 12px; font-weight: 700;">{{ m.champion }}</div>
              <div style="font-size: 9px; color: #444;">{{ m.position | downcase }} &middot; {{ m.durationMin }}m</div>
            </div>
            <div style="margin-left: auto; font-size: 10px; font-weight: 700; border: 1.5px solid #000; padding: 1px 5px;">
              {% if m.win %}W{% else %}L{% endif %}
            </div>
          </div>
          <div style="font-size: 10px; margin-bottom: 3px;">
            {{ m.kills }}/{{ m.deaths }}/{{ m.assists }} &middot; {{ m.kda }} KDA
            {% if m.avgOpponentRank %}<span style="color: #444;">&middot; Gg&oslash; {{ m.avgOpponentRank }}</span>{% endif %}
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; font-size: 9px; color: #333;">
            <span>CS/min {{ m.csPerMin }}</span>
            <span>Vision/min {{ m.visionScorePerMin }}</span>
            <span>Dmg/min {{ m.damagePerMin }}</span>
            <span>Gold/min {{ m.goldPerMin }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div style="border-top: 2px solid #000; padding-top: 8px; flex: 1;">
    <div style="font-size: 9px; color: #555; margin-bottom: 6px;">TOP CHAMPIONS</div>
    <div style="display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: repeat(2, auto); gap: 6px 20px;">
      {% for c in topChampions %}
        <div style="display: flex; align-items: center; gap: 8px;">
          <img
            src="https://ddragon.leagueoflegends.com/cdn/{{ ddragonVersion }}/img/champion/{{ c.champion }}.png"
            width="26" height="26"
            style="border: 1.5px solid #000; object-fit: cover; flex-shrink: 0;"
            onerror="this.style.display='none'"
          />
          <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between; font-size: 11px;">
              <span>{{ c.champion }}</span>
              <span style="color: #444;">{{ c.games }}g &middot; {{ c.winrate }}%</span>
            </div>
            <div style="height: 6px; border: 1.5px solid #000; position: relative; margin-top: 2px;">
              <div style="position:absolute; top:0; left:0; bottom:0; width: {{ c.winrate }}%; background:#000;"></div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div style="text-align: right; font-size: 9px; color: #666; margin-top: 6px;">
    updated {{ updatedAt }} &middot; refresh every 30 min
  </div>

</div>
</div>
